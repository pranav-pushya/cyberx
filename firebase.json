{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "firestore.indexes.json",
      ".env*",
      "**/.*",
      "**/node_modules/**",
      ".git/**",
      ".vscode/**",
      "server.js",
      "package*.json",
      "Readme.md"
    ],
    "cleanUrls": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
